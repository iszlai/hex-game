; Hexflow — Godot project configuration
; Engine version is pinned in README.md. Do not float.

config_version=5

[application]

config/name="Hexflow"
config/version="0.1.0"
run/main_scene="res://src/scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

; The window and dock icon. Unset, this was the Godot logo — the project had a
; logo and no icon, which are not the same file: one is read at 1024 px and the
; other is recognised at 32. `make icon` cuts this out of `assets/art/logo.png`
; and it is committed like the rest of the generated art (C-31).
config/icon="res://assets/icons/icon.png"

; No engine splash at all — `boot.tscn` is the game's title screen, and two title
; screens in a row is one too many. The mark held for 700 ms and then the *same
; name* faded up again over the backdrop, which read as a stutter rather than as
; an opening. What is left is the palette's darkest surface, so the window that
; exists while the engine loads is the colour the game is about to be rather than
; a flash of grey. `assets/art/logo.png` is still the store and window icon.
boot_splash/show_image=false
boot_splash/bg_color=Color(0.101961, 0.078431, 0.062745, 1)

[autoload]

EventBus="*res://src/app/event_bus.gd"
SettingsService="*res://src/app/settings_service.gd"
SaveService="*res://src/app/save_service.gd"
AudioDirector="*res://src/app/audio_director.gd"
SteamService="*res://src/app/steam_service.gd"
GameDirector="*res://src/app/game_director.gd"

; §22's strings, as a data drop: one CSV with a column per language, imported to
; a `.translation` per locale. The list is here rather than loaded in code because
; the engine needs it before the first screen exists — a menu that has to wait for
; an autoload to install its own language flashes English first.
;
; `en` is the fallback, so a key nobody has translated yet shows the English
; rather than the key: a missing translation must cost the player a word, never a
; screen (C-39).
[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/strings.en.translation", "res://assets/i18n/strings.hu.translation")
locale/fallback="en"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.039216, 0.054902, 0.078431, 1)
