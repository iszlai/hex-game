    {
      "role": "fonts",
      "dir": "assets/fonts/",
      "ext": ".ttf",
      "kind": "font",
      "want": 4,
      "note": "§13.4's four families (C-30)",
      "brief": "A replacement must be SIL OFL or equivalent, must carry a real `wght` axis (Medium and Bold are a variation, not a second file), and must land with its licence beside it. The display and heading faces are characterful and carry few symbols; the families fall back to one another so a missing glyph is drawn rather than boxed.",
      "items": [
        {
          "name": "BelligerentMadness",
          "for": "Display",
          "make": "Hand-drawn display face. STATIC — no weight axis, and C-30 exempts it: at one size on one screen there is nothing to vary. Its licence requires attribution and the fontmonkey URL to ship beside it",
          "licence": "LICENSE-belligerentmadness.txt",
          "roles": [
            {
              "role": "DISPLAY",
              "size": 48,
              "weight": 800
            }
          ]
        },
        {
          "name": "Caveat",
          "for": "Heading",
          "make": "Handwritten — a note left by hand. Never used below 32 px (C-30)",
          "licence": "LICENSE-caveat.txt",
          "roles": [
            {
              "role": "HEADING",
              "size": 32,
              "weight": 700
            }
          ]
        },
        {
          "name": "Inter",
          "for": "Body, Caption",
          "make": "Reading face. Must hold up at §13.4's 18 px floor on a 7-inch screen — which is why the handwritten face is not used here",
          "licence": "LICENSE-inter.txt",
          "roles": [
            {
              "role": "BODY",
              "size": 24,
              "weight": 500
            },
            {
              "role": "CAPTION",
              "size": 18,
              "weight": 400
            }
          ]
        },
        {
          "name": "JetBrainsMono",
          "for": "Numeral",
          "make": "Numerals only. TABULAR FIGURES are mandatory — a proportional 1 makes every counter in the game jitter as it counts",
          "licence": "LICENSE-jetbrainsmono.txt",
          "roles": [
            {
              "role": "NUMERAL",
              "size": 24,
              "weight": 500
            }
          ]
        }
      ]
    },
